# Copy this file to .env and fill in real values. Never commit .env itself.

AZURE_GPT_API_KEY=
AZURE_GPT_DEPLOYMENT=gpt-5.4-mini
AZURE_GPT_ENDPOINT_V1=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_GPT_ENDPOINT_CLASSIC=https://YOUR-RESOURCE.openai.azure.com
AZURE_GPT_API_VERSION=2024-02-01
AZURE_DEEPSEEK_DEPLOYMENT=DeepSeek-V4-Pro

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_GEMINI_MODEL=google/gemini-3.7-flash

VERTEX_AI_API_KEY=
VERTEX_MODEL=gemini-3.7-flash

HF_TOKEN=
HF_RESULTS_REPO=your-org/your-results-repo-name

# Needed only for the Colab notebooks, not the local judging scripts --
# get from https://huggingface.co/settings/tokens with access granted to
# meta-llama/Llama-3.1-8B-Instruct (gated model, license must be accepted
# on the model page first). Qwen/Qwen3-8B is NOT gated, no token needed.
HF_TOKEN_LLAMA_GATED=
