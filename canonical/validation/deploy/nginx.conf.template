# Gatekeeper in front of Label Studio.
#
# Free Label Studio has no roles: every account can import data, edit the
# labelling setup and delete projects. This sits in front and refuses the
# dangerous requests unless the browser carries the admin cookie.
#
# Reviewers just use the normal URL. Whoever runs the review visits
#   https://<host>/unlock?key=<ADMIN_KEY>
# once, which sets the cookie in their browser for two years. /lock clears it.
#
# ${ADMIN_KEY} is filled in at start-up by envsubst.

worker_processes 1;
error_log /tmp/nginx/error.log warn;
pid /tmp/nginx/nginx.pid;
events { worker_connections 1024; }

http {
  include       ${MIME_TYPES};
  default_type  application/octet-stream;
  access_log    off;
  sendfile      on;

  client_body_temp_path /tmp/nginx/body;
  proxy_temp_path       /tmp/nginx/proxy;
  fastcgi_temp_path     /tmp/nginx/fastcgi;
  uwsgi_temp_path       /tmp/nginx/uwsgi;
  scgi_temp_path        /tmp/nginx/scgi;

  # Task files run to a few megabytes.
  client_max_body_size 512m;

  map $http_cookie $is_admin {
    default 0;
    "~*prism_admin=${ADMIN_KEY}(;|$)" 1;
  }

  # Requests that can destroy work or change what reviewers see.
  # A denylist rather than an allowlist: the risk being managed is an accident,
  # and an allowlist that misses an endpoint stops people annotating.
  map "$request_method $request_uri" $danger {
    default 0;

    # create / delete / reconfigure projects
    "~*^POST /api/projects/?(\?|$)"                                    1;
    "~*^(PATCH|PUT|DELETE) /api/projects/"                             1;

    # upload data
    "~*^POST /api/projects/[0-9]+/(import|reimport|file)"              1;
    "~*^(POST|PATCH|PUT|DELETE) /api/import"                           1;

    # bulk destructive actions from the Data Manager
    "~*^POST /api/dm/actions/?\?.*id=(delete_tasks|delete_tasks_annotations|delete_tasks_predictions|remove_duplicates)" 1;

    # delete or create tasks directly
    "~*^DELETE /api/tasks"                                             1;
    "~*^POST /api/tasks/?(\?|$)"                                       1;

    # org membership, invite links, external storage, ML backends
    "~*^(POST|PATCH|PUT|DELETE) /api/(organizations|invite|storages|ml)" 1;
  }

  map "$is_admin$danger" $blocked {
    default 0;
    "01"    1;
  }

  server {
    listen ${LISTEN_PORT};
    server_name _;

    # The host terminates TLS and reaches us over plain HTTP, so nginx would
    # turn "return 302 /" into an absolute "http://host/" and bounce visitors
    # off HTTPS. Emitting a relative Location leaves the browser on the scheme
    # and host it is already using.
    absolute_redirect off;

    location = /unlock {
      if ($arg_key = "${ADMIN_KEY}") {
        add_header Set-Cookie "prism_admin=${ADMIN_KEY}; Path=/; Max-Age=63072000; HttpOnly; SameSite=Lax";
        return 302 /;
      }
      return 403 "Wrong key.\n";
    }

    location = /lock {
      add_header Set-Cookie "prism_admin=; Path=/; Max-Age=0";
      return 302 /;
    }

    location / {
      if ($blocked) {
        return 403 "This account can review translations but cannot change the project setup. Ask whoever runs the review.\n";
      }
      proxy_pass http://127.0.0.1:${INTERNAL_PORT};
      proxy_http_version 1.1;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header Upgrade           $http_upgrade;
      proxy_set_header Connection        $connection_upgrade;
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
    }
  }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  # The host terminates TLS and forwards to us over plain HTTP, so $scheme here
  # is "http" even though the visitor is on https. Pass through whatever the
  # host already told us rather than overwriting it with our own view.
  map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
  }
}
